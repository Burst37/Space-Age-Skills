  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "typescript": "^5.9.0",
    "@axe-core/playwright": "^4.10.0",
    "lighthouse": "^12.0.0",
    "chrome-launcher": "^1.0.0"
  }
