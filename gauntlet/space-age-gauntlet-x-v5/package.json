{
  "name": "space-age-gauntlet-x-v5",
  "version": "5.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "runner": "node --env-file-if-exists=.env scripts/gauntlet-runner-v5.mjs",
    "inspect:web": "node --env-file-if-exists=.env scripts/inspect-web.mjs",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "analyze:reference": "node --env-file-if-exists=.env scripts/analyze-reference.mjs",
    "benchmark": "node --env-file-if-exists=.env scripts/benchmark-scout.mjs",
    "health": "node --env-file-if-exists=.env scripts/provider-health.mjs",
    "resume": "node --env-file-if-exists=.env scripts/gauntlet-runner-v5.mjs --resume",
    "audit:web": "node --env-file-if-exists=.env scripts/web-audit.mjs",
    "runner:v4": "node --env-file-if-exists=.env scripts/gauntlet-runner-v4.mjs",
