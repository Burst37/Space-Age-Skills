OPENAI_MODEL=gpt-5.6

XAI_API_KEY=
XAI_MODEL=grok-4.6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6

# Generic OpenAI-compatible provider
GENERIC_API_KEY=
GENERIC_BASE_URL=
GENERIC_MODEL=

# Optional persistence for web UI/history
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional dedicated multimodal models
OPENAI_VISION_MODEL=
XAI_VISION_MODEL=
