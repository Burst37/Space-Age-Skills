# ─── Direct lab APIs (production / Hermes default: presets/judge-panel-direct.json) ───
# Six independent transports, so no single broker outage can take the judge panel down.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

MOONSHOT_API_KEY=
MOONSHOT_MODEL=kimi-k3

DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# At least one provider is required for LIVE runner mode.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6

XAI_API_KEY=
XAI_MODEL=grok-4.6

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash

# Broker. Optional once the direct keys above are set — the failover chain uses it as a
# backstop when a direct API is down. Also the single-key stopgap for getting started.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-5.6-sol

# Generic OpenAI-compatible provider
GENERIC_API_KEY=
GENERIC_BASE_URL=
GENERIC_MODEL=

# Optional persistence for web UI/history
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional dedicated multimodal models
OPENAI_VISION_MODEL=
XAI_VISION_MODEL=
GEMINI_VISION_MODEL=
GEMINI_VIDEO_MODEL=
