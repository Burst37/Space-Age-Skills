:root{
  /* Sampled from the brand's own artwork — hero.webp and the Drop prints */
  --void:#070D10;      /* night-teal ground, from the rooftop plate */
  --deep:#0E1A1F;      /* raised panel */
  --smoke:#1A4048;     /* atmospheric haze */
  --steel:#4C7479;     /* secondary text / structure */
  --bone:#F8FCFF;      /* primary text */
  --beam:#01F6FE;      /* electric cyan — the abduction beam. THE accent. */
  --amber:#FFC074;     /* sodium street light — warm counter-accent */

  --t-mega:clamp(76px,12.5vw,260px);
  --t-lead:clamp(34px,4.6vw,76px);
  --t-body:clamp(16px,1.15vw,20px);
  --t-micro:12px;
  --s1:8px;--s2:16px;--s3:24px;--s4:40px;--s5:64px;--s6:104px;--s7:168px;--s8:272px;
  --gut:clamp(24px,5vw,104px);
  --ease-out:cubic-bezier(.16,1,.30,1);
  --ease-inout:cubic-bezier(.65,0,.35,1);
  --hair:1px solid rgba(248,252,255,.14);
  --ff-d:"Anton",Impact,Haettenschweiler,"Arial Narrow Bold",sans-serif;
  --ff-b:"Inter Tight",system-ui,-apple-system,sans-serif;
  --ff-m:"JetBrains Mono",ui-monospace,SFMono-Regular,monospace;
}
